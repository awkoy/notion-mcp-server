{
  "name": "notion-mcp-server",
  "version": "3.2.1",
  "mcpName": "io.github.awkoy/notion-mcp-server",
  "type": "module",
  "bin": {
    "notion-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "shx rm -rf build && tsc && shx chmod +x build/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --env-file=.env scripts/e2e.mjs",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js -e NOTION_TOKEN=your_notion_token -e NOTION_PAGE_ID=your_notion_page_id"
  },
  "homepage": "https://github.com/awkoy/notion-mcp-server",
  "keywords": [
    "notion",
    "notion-mcp",
    "notion-mcp-server",
    "notion-api",
    "notion-integration",
    "notion-database",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "vscode",
    "copilot",
    "codex",
    "gemini-cli",
    "chatgpt",
    "anthropic",
    "ai-agent",
    "llm",
    "markdown",
    "headless"
  ],
  "author": {
    "name": "Yaroslav Boiko",
    "email": "y.boikodeveloper@gmail.com",
    "url": "https://yaroslavboiko.com"
  },
  "license": "MIT",
  "description": "Notion MCP server with token auth: connect Claude Code, Claude Desktop, Cursor, VS Code, Codex and any MCP client to Notion. Search, create and edit pages, query databases, comment and upload files. Runs headless in CI and agents.",
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@notionhq/client": "^5.22.0",
    "https-proxy-agent": "9.1.0",
    "node-fetch": "3.3.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awkoy/notion-mcp-server.git"
  }
}
